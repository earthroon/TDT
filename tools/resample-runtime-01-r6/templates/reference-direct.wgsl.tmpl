{{HEADER}}
const MAX_REACH: i32 = 6;
const EPS: f32 = 0.000001;
{{ABI}}
@group(0) @binding(0) var srcTex: texture_2d<f32>;
@group(0) @binding(1) var axialTex: texture_2d<f32>;
@group(0) @binding(2) var dstTex: texture_storage_2d<rgba16float, write>;
@group(0) @binding(3) var<uniform> U: Params;
@group(0) @binding(4) var policyTex: texture_2d<f32>;
{{COORDINATE}}
{{BORDER}}
{{AXIAL}}
{{KERNEL}}
@compute @workgroup_size(8, 8, 1)
fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
  if (!r6ContractValid() || gid.x >= U.outSize.x || gid.y >= U.outSize.y) { return; }
  let p=sourcePosition(gid.xy); let base=sourceBase(p);
  let policySize=textureDimensions(policyTex); let policyCoord=clamp(vec2<i32>(floor((p+vec2<f32>(0.5))/vec2<f32>(U.inSize)*vec2<f32>(policySize))),vec2<i32>(0),vec2<i32>(policySize)-vec2<i32>(1));
  let policyRaw=textureLoad(policyTex,policyCoord,0); let policy=select(vec4<f32>(1.0),policyRaw,(U.flags&1u)!=0u); let field=ellipseField(sampleAxial(p),policy);
  var accumulated=vec4<f32>(0.0); var weightSum=0.0;
  for(var offsetY:i32=-MAX_REACH;offsetY<=MAX_REACH;offsetY++){for(var offsetX:i32=-MAX_REACH;offsetX<=MAX_REACH;offsetX++){
    let logicalSampleCoord=base+vec2<i32>(offsetX,offsetY); let delta=vec2<f32>(logicalSampleCoord)-p; let weight=kernelWeight(ellipseDistance(delta,field));
    if(weight>0.0){accumulated+=loadSourceClamped(logicalSampleCoord)*weight;weightSum+=weight;}
  }}
  textureStore(dstTex,vec2<i32>(gid.xy),select(loadSourceClamped(base),accumulated/weightSum,weightSum>EPS));
}

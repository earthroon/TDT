{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "root-metadata.schema.json",
  "type": "object",
  "required": [
    "signed",
    "signedSha256",
    "signatures"
  ],
  "additionalProperties": true,
  "properties": {
    "signed": {
      "type": "object"
    },
    "signedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array"
    }
  }
}
